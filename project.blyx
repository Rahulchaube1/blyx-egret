use std::cli;
use console;
use egret;

fn main() {
    let argv = cli_args();
    let count = args_len(argv);
    if count == 1 && args_at(argv, 0) == "--help" {
        println!("Summarize richness, singletons and dominance in an ecological field survey.");
        println!("Usage: egret counts");
        println!("Vector arguments are comma-separated; use [] for an empty vector.");
        return;
    }
    let mut result = [];
    if count == 0 {
        result = egret_survey([2, 0, 2]);
    } else {
        if count != 1 { stderr_line("Wrong argument count. Use --help."); process_exit(2); }
        let counts = console_vector(args_at(argv, 0));
        result = egret_survey(counts);
    }
    if len(result) == 0 { stderr_line("Invalid input for Egret. See the package input contract."); process_exit(1); }
    let mut i = 0;
    while i < len(result) {
        println!(at(result, i));
        i += 1;
    }
}
